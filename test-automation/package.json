{
  "name": "hotel-booking-test-automation",
  "version": "1.0.0",
  "description": "E2E test automation for hotel booking platform",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:booking-portal": "playwright test --grep @booking-portal",
    "test:owner-panel": "playwright test --grep @owner-panel",
    "test:admin-panel": "playwright test --grep @admin-panel",
    "test:critical": "playwright test --grep @critical"
  },
  "keywords": ["playwright", "e2e", "testing", "hotel-booking"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
